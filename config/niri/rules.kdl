window-rule {
    match app-id="firefox$"
    match app-id="obsidian"
    open-maximized true
}

window-rule {
    match app-id="vesktop"
    match app-id="[s|S]potify"
    match app-id="steam" title="^Steam$"
    open-maximized-to-edges true
}

window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="steam"
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
}

window-rule {
    match app-id="mpv"
    open-maximized-to-edges true // Maximize to edges when leaving fullscreen
    open-fullscreen true // Default is fullscreen as it's the last option
}

window-rule {
    match app-id="org.qbittorrent.qBittorrent"
    default-column-width { proportion 0.66; }
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

